APP_NAME=PruebaLogin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# API sin estado: no se usan sesiones/cache en base de datos
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQL Server (requiere extensiones sqlsrv y pdo_sqlsrv)
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=PruebaLogin
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd

# JWT
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
JWT_TTL_MINUTES=60

# CORS (origen del frontend Angular)
FRONTEND_URL=http://localhost:4200

# Recuperacion de contrasena: en desarrollo la API devuelve el enlace (sin SMTP)
PASSWORD_RESET_DEV_LINK=true
